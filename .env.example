# Neon Postgres connection string
DATABASE_URL="postgres://user:password@endpoint-pooler.region.neon.tech/neondb?sslmode=require"

# Random 32+ byte hex string used for daily salted visitor hash
SALT="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Dashboard login password
DASHBOARD_PASSWORD="change_me_to_a_secure_password"

# Secret token for Vercel Cron endpoints
CRON_SECRET="cron_secret_token_123456"

# Comma-separated list of allowed origins for the event collector (leave empty or * to allow all during setup)
ALLOWED_ORIGINS="http://localhost:3000,https://example.com"
